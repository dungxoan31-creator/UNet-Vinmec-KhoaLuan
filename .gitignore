# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/

# Local databases & logs
ovarian_ai.db
*.sqlite3
*.log

# Runtime uploads & temporary reports (preserve folders via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Large pre-trained checkpoints (tracked via Git LFS or external storage)
# checkpoints/*.pth
dataset/
ai_training/experiments/*/*.pth
ai_training/models/
ai_training/dataset_preview/
ai_training/evaluation_samples/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Virtual environments
venv/
.venv/
env/

# Office temporary lock and backup files
~$*.docx
~$*.xlsx
~$*.pptx
*.bak
*.tmp

.aider*
