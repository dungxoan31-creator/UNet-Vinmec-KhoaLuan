# ==============================================================================
# .gitignore — UNet-Vinmec-KhoaLuan
# Production & Research Human-in-the-Loop Ovarian Ultrasound AI
# ==============================================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*$py.class
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Dependency installations
node_modules/

# Local runtime databases & secrets (never commit secrets or local dev databases)
ovarian_ai.db
*.sqlite3
*.db-journal
**/.app_jwt_secret
**/.patient_pid_hmac_secret
.env
.env.local

# Runtime logs & temporary debug traces
*.log
*.tmp
*.bak
*.copy
*~
playwright-report/
test-results/
.playwright-mcp/
.impeccable/
.superpowers/
.taste-skill/
.tmp-verify-*/
scratch/

# Runtime uploads & generated reports (preserve directories via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Active learning runtime queues
/data/active_learning_queue.jsonl
/data/active_learning_queue.jsonl.lock
/metadata/active_learning_queue.jsonl
/metadata/active_learning_queue.jsonl.lock

# Test artifacts (preserve synthetic fixtures and release verification assets)
artifacts/*
!artifacts/synthetic_fixtures/
!artifacts/audit_remediation_2026_10_28/
!artifacts/.gitkeep

# Local portable tooling and execution binaries
.git_bin/

# Model checkpoint weights (stored on Cloud/Release Assets, excluded from raw Git commit due to GitHub 100MB limit)
*.pth
*.pt
*.ckpt
*.safetensors

# Dataset binary images (stored in Cloud package; metadata manifests preserved)
dataset/2d/
dataset/3d/
!dataset/index.csv
!dataset/external_manifest_mmotu.json

# System backups and archives
backups/*
!backups/.gitkeep
*.tar.gz
*.7z
*.zip

# nnUNet intermediate arrays
nnUNet_preprocessed/
nnUNet_raw/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx
